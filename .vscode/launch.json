{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "adk web",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "cwd": "${workspaceFolder}/currency_converter/src/agents/currency_converter/app",
            "envFile": "${workspaceFolder}/currency_converter/src/agents/currency_converter/app/.env",
            "justMyCode": false,
            "args": [
                "web",
                "--no-reload",
                "--log_level",
                "debug"
            ]
        },
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/currency_converter/src/agents/currency_converter/app/.env",
            "program": "${file}"
        }
    ]
}