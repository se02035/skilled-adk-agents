{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "adk web",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "cwd": "${workspaceFolder}/src/skill-agent",
            "envFile": "${workspaceFolder}/src/skill-agent/app/.env",
            "justMyCode": false,
            "args": [
                "web",
                "--no-reload",
                "--log_level",
                "debug"
            ]
        },
        {
            "name": "adk a2a",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/src/skill-agent/app/.env",
            "cwd": "${workspaceFolder}/src/skill-agent",
            "program": "${workspaceFolder}/src/skill-agent/app/a2a_agent.py"
        },
        {
            "name": "mcp skills",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src/mcp-skills-provider",
            "program": "${workspaceFolder}/src/mcp-skills-provider/server.py",
            "env": {
                "SKILLS_DIRECTORY": "${workspaceFolder}/.agents/skills",
                "PORT": "5555",
                "MCP_GOOGLE_AUTH_ENABLED": "false"
            }
        },
        {
            "name": "mcp skills apps preview",
            "type": "debugpy",
            "request": "launch",
            "module": "fastmcp.cli",
            "cwd": "${workspaceFolder}/src/mcp-skills-provider",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "dev",
                "apps",
                "server.py"
            ],
            "env": {
                "SKILLS_DIRECTORY": "${workspaceFolder}/.agents/skills",
                "MCP_GOOGLE_AUTH_ENABLED": "false"
            }
        }
    ]
}