{
    "name": "Python + Google Agents CLI + Gemini CLI",
    "build": {
      "dockerfile": "Dockerfile",
      "context": ".."
    },
    "remoteUser": "vscode",
    "updateRemoteUserUID": false,
    "userEnvProbe": "none",
    "updateContentCommand": "/bin/true",
    "securityOpt": ["label=disable"],
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "ms-python.vscode-pylance"
        ],
        "settings": {
          "python.defaultInterpreterPath": "/usr/local/bin/python3"
        }
      }
    },
    "forwardPorts": [8080],
    "portsAttributes": {
      "8080": {
        "label": "agents-cli playground (optional)"
      }
    }
  }
  