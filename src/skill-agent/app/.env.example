# ALL RELEVANT VARIABLES FOR ADK AGENT
# ====================================
#
# Google Cloud Project and Vertex AI
GOOGLE_CLOUD_PROJECT="<YOUR_GCP_PROJECT>"
GOOGLE_CLOUD_LOCATION="<YOUR_GCP_LOCATION e.g. us-central1>"
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# ADK Agent Configuration
ADK_AGENT_NAME="skill_assistant"
# Native Gemini/Vertex model id (default), or "litellm" to use a LiteLLM proxy
ADK_AGENT_MODEL="gemini-3.5-flash"
# LiteLLM proxy mode (required when ADK_AGENT_MODEL=litellm)
# Use the proxy root URL (no /v1 suffix).
# LITELLM_MODEL must match the exact Model Name from LiteLLM Model Management, e.g.:
#   ollama/gemma3:4b.ollama
#   gemini-2.5-flash
#   gemini-3.1-pro-preview
# ADK_AGENT_MODEL="litellm"
# LITELLM_API_BASE="http://localhost:4000"
# LITELLM_MODEL="gemini-2.5-flash"
# LITELLM_VIRTUAL_KEY="sk-..."
ADK_AGENT_VERSION="1.0.0"
ADK_AGENT_DESCRIPTION="A versatile assistant that supports a broad range of skills."

# A2A Server configuration
A2A_PORT="8001"
TUNNEL_ADDRESS="<PUBLIC_TUNNEL_ENDPOINT>"

# MCP tools configuration
MCP_SKILLS_PROVIDER_ENDPOINT="http://0.0.0.0:5555/mcp"
# Workspace root for skills and shell execution (defaults to repository root)
# MCP_SKILLS_PROVIDER_WORKSPACE_DIRECTORY="/absolute/path/to/skilled-adk-agents"

# Desktop Commander MCP (shell execution only via npx)
# Requires Node.js and npm. Config is auto-created at MCP_DESKTOP_COMMANDER_CWD/config.json
# MCP_DESKTOP_COMMANDER_CWD="/absolute/path/to/skilled-adk-agents/.desktop-commander"
MCP_DESKTOP_COMMANDER_DEFAULT_SHELL="/bin/zsh"
MCP_DESKTOP_COMMANDER_BLOCKED_COMMANDS="rm -rf /,rm -rf ~,sudo,shutdown,reboot"
MCP_DESKTOP_COMMANDER_ALLOWED_DIRECTORIES="/absolute/path/to/skilled-adk-agents"
MCP_DESKTOP_COMMANDER_TELEMETRY_ENABLED=false

# Unsupported inline attachments (e.g. .pptx) are saved under uploads/ in the workspace
# ATTACHMENT_MAX_FILENAME_LENGTH=200

# Shell command timeouts (start_process uses timeout_ms; practical MCP ceiling is often ~60s)
MCP_SHELL_RUNNER_TIMEOUT_SECONDS=120
MCP_SHELL_RUNNER_SKILLS_INSTALL_TIMEOUT_SECONDS=600
MCP_SHELL_RUNNER_MAX_TIMEOUT_MS=60000
